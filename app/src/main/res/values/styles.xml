<?xml version="1.0" encoding="utf-8"?>
<!-- Text styles used across the Memory Lane app -->
<resources>

    <!-- Big title at the top of each screen -->
    <style name="MemoryLaneTitle">
        <item name="android:fontFamily">@font/dm_serif_display</item>
        <item name="android:textSize">32sp</item>
        <item name="android:textColor">?attr/colorPrimary</item>
    </style>

    <!-- Title for each section -->
    <style name="MemoryLaneSectionTitle">
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textSize">20sp</item>
        <item name="android:textColor">?attr/colorPrimary</item>
    </style>

    <!-- Normal text used for most content -->
    <style name="MemoryLaneBody">
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
    </style>

    <!-- Smaller, lighter text for extra info -->
    <style name="MemoryLaneCaption">
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">?attr/colorOnSurfaceVariant</item>
    </style>

    <!-- Italic slogan under the app name on the home screen -->
    <style name="MemoryLaneTagline">
        <item name="android:fontFamily">serif</item>
        <item name="android:textStyle">italic</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">?attr/colorOnSurfaceVariant</item>
    </style>

    <!-- Title inside the memory cards -->
    <style name="MemoryLaneCardTitle">
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textSize">18sp</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
    </style>

</resources>