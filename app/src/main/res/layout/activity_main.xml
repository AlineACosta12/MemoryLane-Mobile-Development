<?xml version="1.0" encoding="utf-8"?>
<!-- Layout for the Home screen (MainActivity) -->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/colorBackground"
    tools:context=".MainActivity">

    <!-- ScrollView lets the user scroll if the content doesn't fit on the screen -->
    <ScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:padding="24dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <!-- Puts all the items one under the other -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- App name at the top -->
            <TextView
                android:id="@+id/textAppTitle"
                style="@style/MemoryLaneTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Memory Lane" />

            <!-- Short slogan under the app name -->
            <TextView
                android:id="@+id/textTagline"
                style="@style/MemoryLaneTagline"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Places hold stories." />

            <!-- AROUND YOU SECTION -->
            <!-- Section title for memories near the user -->
            <TextView
                android:id="@+id/textAroundYouTitle"
                style="@style/MemoryLaneSectionTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="Around You" />

            <!-- Card for a nearby memory -->
            <androidx.cardview.widget.CardView
                android:id="@+id/cardNearbyMemory1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="12dp"
                app:cardBackgroundColor="?attr/colorSurface"
                app:cardCornerRadius="20dp"
                app:cardElevation="2dp">

                <!-- Content inside the card, one under the other -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <!-- Memory title -->
                    <TextView
                        android:id="@+id/textNearbyMemoryTitle1"
                        style="@style/MemoryLaneBody"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="First Coffee Together"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <!-- How far the memory is from the user -->
                    <TextView
                        android:id="@+id/textNearbyMemoryDistance1"
                        style="@style/MemoryLaneCaption"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="340 m away" />

                    <!-- Date of the memory -->
                    <TextView
                        android:id="@+id/textNearbyMemoryDate1"
                        style="@style/MemoryLaneCaption"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="January 2025" />

                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- RECENTLY ADDED SECTION -->
            <!-- Section title for the newest memories -->
            <TextView
                android:id="@+id/textRecentlyAddedTitle"
                style="@style/MemoryLaneSectionTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:layout_marginBottom="12dp"
                android:text="Recently Added" />

            <!-- Card for a recently added memory -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                app:cardBackgroundColor="?attr/colorSurface"
                app:cardCornerRadius="20dp"
                app:cardElevation="2dp">

                <!-- Content inside the card, one under the other -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <!-- Memory title -->
                    <TextView
                        android:id="@+id/textRecentMemoryTitle1"
                        style="@style/MemoryLaneBody"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Malta"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <!-- Memory category -->
                    <TextView
                        android:id="@+id/textRecentMemoryCategory1"
                        style="@style/MemoryLaneCaption"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Adventure" />

                    <!-- Date of the memory -->
                    <TextView
                        android:id="@+id/textRecentMemoryDate1"
                        style="@style/MemoryLaneCaption"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="September 2026" />

                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- BUTTONS -->
            <!-- Button to open the Add Memory screen -->
            <Button
                android:id="@+id/buttonAddMemory"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="+ Add Memory" />

            <!-- Outlined button to open the All Memories screen -->
            <Button
                android:id="@+id/buttonViewAll"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="24dp"
                android:text="View All Memories" />

        </LinearLayout>
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>