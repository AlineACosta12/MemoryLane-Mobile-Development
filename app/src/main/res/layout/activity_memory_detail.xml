<?xml version="1.0" encoding="utf-8"?>
<!-- Layout for the Memory Detail screen -->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/colorBackground"
    tools:context=".MemoryDetailActivity">

    <!-- ScrollView lets the user scroll if the content doesn't fit on the screen -->
    <ScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <!-- Puts all the items one under the other -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp" >

            <!-- Screen title -->
            <TextView
                android:id="@+id/textMemoryDetailTitle"
                style="@style/MemoryLaneTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Memory Detail" />

            <!-- Title of the memory -->
            <TextView
                android:id="@+id/textMemoryTitle"
                style="@style/MemoryLaneSectionTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="First Coffee Together"
                android:textSize="22sp" />

            <!-- Date of the memory -->
            <TextView
                android:id="@+id/textMemoryDate"
                style="@style/MemoryLaneCaption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="January 2025" />

            <!-- Category of the memory -->
            <TextView
                android:id="@+id/textMemoryCategory"
                style="@style/MemoryLaneCaption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Together" />

            <!-- DESCRIPTION -->
            <!-- Label for the description -->
            <TextView
                android:id="@+id/textDescriptionLabel"
                style="@style/MemoryLaneSectionTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="Description"
                android:textSize="16sp" />

            <!-- The description text of the memory -->
            <TextView
                android:id="@+id/textMemoryDescription"
                style="@style/MemoryLaneBody"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Our first coffee together after a long walk around the city."
                android:textSize="15sp" />

            <!-- LOCATION -->
            <!-- Label for the location -->
            <TextView
                android:id="@+id/textLocationLabel"
                style="@style/MemoryLaneSectionTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="Location"
                android:textSize="16sp" />

            <!-- How far the memory is from the user -->
            <TextView
                android:id="@+id/textMemoryDistance"
                style="@style/MemoryLaneBody"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="340 m away"
                android:textSize="15sp" />

            <!-- BUTTONS -->
            <!-- Button to open the memory location in a maps app -->
            <Button
                android:id="@+id/buttonOpenMaps"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:minHeight="48dp"
                android:text="Open in Maps" />

            <!-- Button to share the memory with other apps -->
            <Button
                android:id="@+id/buttonShareMemory"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:minHeight="48dp"
                android:text="Share Memory" />
        </LinearLayout>
    </ScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>